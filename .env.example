# Cyber Sentinel X example configuration
# Copy to .env for local use. Never publish your actual credentials.

CYBER_SENTINEL_SECRET=
CSX_INTERFACE=eth0
CYBER_SENTINEL_INTERFACE=eth0
CSX_TRUSTED_PROXY_IPS=

# Email notifications
CSX_EMAIL_ENABLED=0
CSX_SMTP_HOST=smtp.gmail.com
CSX_SMTP_PORT=587
CSX_SMTP_USER=
CSX_SMTP_PASSWORD=
CSX_ALERT_EMAIL_FROM=
CSX_ALERT_EMAIL_TO=

# Twilio phone alerts
CSX_VOICE_ENABLED=0
CSX_TWILIO_TRIAL_MODE=1
CSX_TWILIO_SID=
CSX_TWILIO_TOKEN=
CSX_TWILIO_FROM=
CSX_ALERT_PHONE=

# Offline voice alerts
CSX_LOCAL_VOICE_ENABLED=0
CSX_NOTIFY_POLL_SECONDS=10

# Optional local geolocation databases
CSX_GEOIP_CITY_DB=
CSX_GEOIP_ASN_DB=

# Firewall safety defaults
CSX_FIREWALL_EXECUTE=0
CSX_FIREWALL_ALLOW_PRIVATE=0
CSX_FIREWALL_ALLOWLIST=
